#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:31
msgid "How to Get a Pinterest Access Token"
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:34
msgid "Captain Social Feed uses Pinterest API v5 to fetch pins from a board. You need an Access Token and the Board ID."
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:42
msgid "Create a Pinterest App"
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:43
msgid "Go to the Pinterest Developers portal, sign in, and create a new app."
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:54
msgid "Authorize with the \"boards:read\" and \"pins:read\" Scopes"
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:55
msgid "Use Pinterest's OAuth flow to log in and authorize your app for these two read scopes."
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:62
msgid "Get Your Access Token"
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:63
msgid "After authorizing, exchange the authorization code for an Access Token via Pinterest's token endpoint."
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:68
msgid "Keep your Access Token private - never share it publicly."
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:76
msgid "Find Your Board ID"
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:77
msgid "Query \"/v5/boards\" with your Access Token to list your boards and their IDs, or open the board on Pinterest.com and check its URL/settings."
msgstr ""

#: src/page/docs/pinterest-access-token/pinterest-access-token.jsx:88
msgid "In WordPress admin, go to Captain Social Feed → Create Feed → Pinterest, then paste your Access Token and Board ID."
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:31
msgid "How to Get a Threads Access Token"
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:34
msgid "Captain Social Feed uses the official Threads API (by Meta) to fetch your posts. You need a long-lived Access Token and your Threads User ID."
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:42
msgid "Create a Meta App with the Threads Use Case"
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:43
msgid "Go to Meta for Developers, create a new app, and add the \"Threads API\" use case to it."
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:54
msgid "Authorize Your Threads Account"
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:55
msgid "Use the Threads API's OAuth authorization flow to log in with your Threads account and grant the \"threads_basic\" permission."
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:62
msgid "Exchange for a Long-Lived Token"
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:63
msgid "The initial token is short-lived. Exchange it for a long-lived token (valid ~60 days) via the token exchange endpoint."
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:76
msgid "Find Your Threads User ID"
msgstr ""

#: src/page/docs/threads-access-token/threads-access-token.jsx:77
