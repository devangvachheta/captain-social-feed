msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:99
msgid "Click Action:"
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:100
msgid "\"Open in Popup\" shows photos and videos in a lightbox on your site. \"Play Inline on Page\" plays videos inside the card. Videos use the direct video file when the platform provides one, otherwise the platform's own embeddable player (Facebook, X, Pinterest). Videos that can be played neither way, and text-only posts, open the original post, because social networks do not allow their normal pages to be shown inside another site."
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:107
msgid "Caching"
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:109
msgid "Cache Duration"
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:110
msgid "Settings → Cache Management → API Cache Duration sets how long posts are kept before the platform is asked again. Longer durations mean fewer API calls."
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:112
#: src/page/settings/settings.jsx:242
msgid "Cache Storage"
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:113
msgid "\"WordPress transients\" is the default. Choose \"Plugin database table\" if another plugin, an object cache or your host keeps clearing transients. Switching clears the cache once."
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:115
#: src/page/settings/settings.jsx:270
msgid "Fallback Cache"
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:116
msgid "When on (default), the last successful posts are kept in the plugin table and shown if a platform request fails, for example an expired token or a rate limit, so visitors never see an empty feed."
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:118
msgid "Clearing the cache"
msgstr ""

#: src/page/docs/customize-feed/customize-feed.jsx:119
msgid "Use \"Clear Cache\" in Settings to refresh every feed, or \"Clear This Feed Cache\" in Step 4 (Insert Code) of a feed to refresh just that one. Changing the settings of a feed also refreshes its cache."
msgstr ""

