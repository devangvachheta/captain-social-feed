#: includes/admin/class-capsf-abilities.php:81
msgid "Create and manage social media feeds (Instagram, Facebook, X, Threads, Pinterest) on this site."
msgstr ""

#: includes/admin/class-capsf-abilities.php:216
msgid "Common keys: columns / columns_tablet / columns_mobile (int), max_results (int, posts to show), layout_category (\"grid\", \"slider\", \"playlist\" or \"reel\"), card_style (e.g. \"social-2\" Social Post, \"social-1\" Image First, \"style-1\", \"style-2\", \"style-3\", \"style-6\", \"style-8\", \"reel-1\"), post_filter (\"all\", \"video\", \"photo\" or \"text\"), caption_mode (\"show_more\" or \"scroll\"), pagination_type (\"none\" or \"load_more\"), show_channel_name / show_description / show_view_count / show_date / equal_height (bool), video_play_mode (\"platform\" = open the original post, \"lightbox\" = popup, \"inline\"), style_preset (\"light\" or \"dark\"). Other keys are saved as-is after sanitizing."
msgstr ""

#: includes/admin/class-capsf-abilities.php:228
msgid "Instagram: access_token + account_id. Facebook: access_token + page_id. X/Twitter: bearer_token + username. Threads: access_token + account_id. Pinterest: access_token + board_id."
msgstr ""

